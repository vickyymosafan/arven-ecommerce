  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId, configurationHash])
  @@map("cart_items")
}

model Order {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber        String      @unique @map("order_number") @db.VarChar(32)
  userId             String?     @map("user_id") @db.Uuid
  guestEmail         String?     @map("guest_email") @db.VarChar(320)
  guestTokenHash     String?     @map("guest_token_hash") @db.Char(64)
  status             OrderStatus @default(PENDING_PAYMENT)
  currency           String      @default("IDR") @db.VarChar(3)
  subtotalIdr        BigInt      @map("subtotal_idr") @db.BigInt
  discountTotalIdr   BigInt      @map("discount_total_idr") @db.BigInt
  shippingTotalIdr   BigInt      @map("shipping_total_idr") @db.BigInt
  taxTotalIdr        BigInt      @default(0) @map("tax_total_idr") @db.BigInt
  grandTotalIdr      BigInt      @map("grand_total_idr") @db.BigInt
  shippingProvider   String      @map("shipping_provider") @db.VarChar(64)
  shippingService    String      @map("shipping_service") @db.VarChar(64)
  couponCodeSnapshot String?     @map("coupon_code_snapshot") @db.VarChar(64)
  addressSnapshot    Json        @map("address_snapshot") @db.JsonB
  paymentExpiresAt   DateTime    @map("payment_expires_at") @db.Timestamptz(3)
  paidAt             DateTime?   @map("paid_at") @db.Timestamptz(3)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user              User?                @relation(fields: [userId], references: [id], onDelete: Restrict)
  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  stockReservations StockReservation[]
  payments          Payment[]
  refunds           Refund[]
  shipments         Shipment[]
  couponRedemptions CouponRedemption[]
  reviews           Review[]
  returns           Return[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId               String   @map("order_id") @db.Uuid
  variantId             String?  @map("variant_id") @db.Uuid
  skuSnapshot           String   @map("sku_snapshot") @db.VarChar(64)
  productNameSnapshot   String   @map("product_name_snapshot") @db.VarChar(220)
  sizeSnapshot          String   @map("size_snapshot") @db.VarChar(32)
  colorSnapshot         String   @map("color_snapshot") @db.VarChar(64)
  unitPriceIdr          BigInt   @map("unit_price_idr") @db.BigInt
  discountAllocatedIdr  BigInt   @default(0) @map("discount_allocated_idr") @db.BigInt
  quantity              Int
  lineTotalIdr          BigInt   @map("line_total_idr") @db.BigInt
