// =============================================================================
// Domain 4: Inventory Ledger (AMB-02, AMB-03)
// =============================================================================

model Warehouse {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String          @unique @db.VarChar(32)
  name       String          @db.VarChar(120)
  city       String          @db.VarChar(120)
  province   String          @db.VarChar(120)
  postalCode String          @map("postal_code") @db.VarChar(16)
  status     WarehouseStatus @default(ACTIVE)
  isDefault  Boolean         @default(false) @map("is_default")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  inventoryLevels    InventoryLevel[]
  inventoryMovements InventoryMovement[]
  stockReservations  StockReservation[]
  shipments          Shipment[]

  @@map("warehouses")
}

model InventoryLevel {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseId       String   @map("warehouse_id") @db.Uuid
  variantId         String   @map("variant_id") @db.Uuid
  quantityOnHand    Int      @default(0) @map("quantity_on_hand")
  quantityReserved  Int      @default(0) @map("quantity_reserved")
  lowStockThreshold Int      @default(5) @map("low_stock_threshold")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, variantId])
  @@map("inventory_levels")
}

model InventoryMovement {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseId   String                @map("warehouse_id") @db.Uuid
  variantId     String                @map("variant_id") @db.Uuid
  type          InventoryMovementType
  quantityDelta Int                   @map("quantity_delta")
  referenceType String                @map("reference_type") @db.VarChar(64)
  referenceId   String?               @map("reference_id") @db.Uuid
  reason        String?               @db.VarChar(255)
  actorId       String?               @map("actor_id") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  actor     User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt(sort: Desc)])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

model StockReservation {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String                 @map("order_id") @db.Uuid
  warehouseId String                 @map("warehouse_id") @db.Uuid
  variantId   String                 @map("variant_id") @db.Uuid
  quantity    Int
  status      StockReservationStatus @default(ACTIVE)
  expiresAt   DateTime               @map("expires_at") @db.Timestamptz(3)
  releasedAt  DateTime?              @map("released_at") @db.Timestamptz(3)
  committedAt DateTime?              @map("committed_at") @db.Timestamptz(3)
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  order     Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([orderId, warehouseId, variantId])
  @@index([orderId])
  @@index([status, expiresAt])
  @@map("stock_reservations")
}

// =============================================================================
