  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt(sort: Desc)])
  @@map("journal_articles")
}

model Lookbook {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String    @unique @db.VarChar(180)
  title       String    @db.VarChar(220)
  season      String    @db.VarChar(64)
  description String?   @db.Text
  slides      Json      @db.JsonB
  status      CmsStatus @default(DRAFT)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("lookbooks")
}

model MediaAsset {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  objectKey  String   @unique @map("object_key") @db.VarChar(512)
  url        String   @db.Text
  mimeType   String   @map("mime_type") @db.VarChar(120)
  bytes      BigInt   @db.BigInt
  width      Int?
  height     Int?
  altText    String   @map("alt_text") @db.VarChar(255)
  uploadedBy String?  @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  uploader User? @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@map("media_assets")
}

// =============================================================================
// Domain 11: Platform (Audit, Outbox & Idempotency)
// =============================================================================

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  actorRole   String?  @map("actor_role") @db.VarChar(64)
  requestId   String?  @map("request_id") @db.VarChar(64)
  action      String   @db.VarChar(120)
  resource    String   @db.VarChar(80)
  resourceId  String   @map("resource_id") @db.VarChar(120)
  beforeState Json?    @map("before_state") @db.JsonB
  afterState  Json?    @map("after_state") @db.JsonB
  ipAddress   String?  @map("ip_address") @db.Inet
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([resource, resourceId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregateType String       @map("aggregate_type") @db.VarChar(80)
  aggregateId   String       @map("aggregate_id") @db.Uuid
  eventType     String       @map("event_type") @db.VarChar(120)
  schemaVersion Int          @default(1) @map("schema_version")
  payload       Json         @db.JsonB
  status        OutboxStatus @default(PENDING)
  occurredAt    DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(3)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError     String?      @map("last_error") @db.Text

  @@index([status, nextAttemptAt(sort: Asc)])
  @@map("outbox_events")
}

model IdempotencyRecord {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idempotencyKey String            @map("idempotency_key") @db.VarChar(128)
  actorScope     String            @map("actor_scope") @db.VarChar(160)
  route          String            @db.VarChar(160)
  requestHash    String            @map("request_hash") @db.Char(64)
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body") @db.JsonB
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([idempotencyKey, actorScope, route])
  @@index([expiresAt])
  @@map("idempotency_records")
}
