  providerTransactionId String?       @map("provider_transaction_id") @db.VarChar(160)
  method                String?       @db.VarChar(64)
  status                PaymentStatus @default(PENDING)
  amountIdr             BigInt        @map("amount_idr") @db.BigInt
  currency              String        @default("IDR") @db.VarChar(3)
  snapToken             String?       @map("snap_token") @db.VarChar(255)
  redirectUrl           String?       @map("redirect_url") @db.Text
  expiresAt             DateTime      @map("expires_at") @db.Timestamptz(3)
  settledAt             DateTime?     @map("settled_at") @db.Timestamptz(3)
  failureReason         String?       @map("failure_reason") @db.Text
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events  PaymentEvent[]
  refunds Refund[]

  @@index([orderId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@map("payments")
}

model PaymentEvent {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId       String?   @map("payment_id") @db.Uuid
  provider        String    @db.VarChar(64)
  providerEventId String    @map("provider_event_id") @db.VarChar(180)
  eventType       String    @map("event_type") @db.VarChar(80)
  signatureValid  Boolean   @map("signature_valid")
  payload         Json      @db.JsonB
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(3)
  processingError String?   @map("processing_error") @db.Text
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@map("payment_events")
}

model Refund {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String       @map("order_id") @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  returnId         String?      @map("return_id") @db.Uuid
  refundKey        String       @unique @map("refund_key") @db.VarChar(120)
  providerRefundId String?      @map("provider_refund_id") @db.VarChar(160)
  status           RefundStatus @default(REQUESTED)
  amountIdr        BigInt       @map("amount_idr") @db.BigInt
  currency         String       @default("IDR") @db.VarChar(3)
  reason           String       @db.Text
  requestedBy      String       @map("requested_by") @db.Uuid
  approvedBy       String?      @map("approved_by") @db.Uuid
  gatewayResponse  Json?        @map("gateway_response") @db.JsonB
  completedAt      DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  order        Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment      Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  returnRecord Return? @relation(fields: [returnId], references: [id], onDelete: SetNull)
  requester    User    @relation("RefundRequestedBy", fields: [requestedBy], references: [id], onDelete: Restrict)
  approver     User?   @relation("RefundApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("refunds")
}

