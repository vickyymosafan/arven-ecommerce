generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Canonical Enums (26 Enums — docs/DATA_MODEL.md §3 + AMB-01, AMB-03, AMB-06, Phase 08)
// =============================================================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum SessionScope {
  CUSTOMER
  ADMIN
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  MFA_CHALLENGE
}

enum ProductStatus {
  DRAFT
  REVIEW
  READY_TO_PUBLISH
  PUBLISHED
  ARCHIVED
}

enum CollectionStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum MediaType {
  IMAGE
  SWATCH
  VIDEO
  POSTER
}

enum AssetStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum AssetFormat {
  GLB
  GLTF
}

enum AssetValidationStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum InventoryMovementType {
  RECEIPT
  RESERVATION
  RELEASE
  SALE
  ADJUSTMENT
  RETURN_TO_STOCK
}

enum StockReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
}

enum CartStatus {
  ACTIVE
  MERGED
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  EXPIRED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURNED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  SETTLEMENT
  FAILED
  EXPIRED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  SUCCEEDED
  FAILED
  REJECTED
}

enum ShipmentStatus {
  UNFULFILLED
  READY_TO_SHIP
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum CouponStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  ARCHIVED
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
  REJECTED
}

enum ReturnStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
  CLOSED
}

enum ReturnItemCondition {
  UNOPENED
  GOOD
  DAMAGED
  DEFECTIVE
}

enum CmsStatus {
  DRAFT
  PREVIEW
  PUBLISHED
  ARCHIVED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ShowroomZoneStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// =============================================================================
// Domain 1: Identity & RBAC
// =============================================================================

model User {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String     @unique @db.VarChar(320)
  passwordHash       String     @map("password_hash") @db.Text
  fullName           String     @map("full_name") @db.VarChar(160)
  phone              String?    @db.VarChar(32)
  status             UserStatus @default(PENDING_VERIFICATION)
  verifiedAt         DateTime?  @map("verified_at") @db.Timestamptz(3)
  mfaSecretEncrypted String?    @map("mfa_secret_encrypted") @db.Text
  mfaEnabled         Boolean    @default(false) @map("mfa_enabled")
  mfaLastTimeStep    Int?       @map("mfa_last_time_step")
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions             Session[]
  verificationTokens   VerificationToken[]
  mfaRecoveryCodes     MfaRecoveryCode[]
  userRoles            UserRole[]           @relation("UserAssignedRoles")
  assignedUserRoles    UserRole[]           @relation("RoleAssignedBy")
  addresses            Address[]
  created3dAssets      Product3DAsset[]
  createdShowroomZones ShowroomZone[]
  outfitScenes         OutfitScene[]
  inventoryMovements   InventoryMovement[]
  carts                Cart[]
  orders               Order[]
  orderStatusHistories OrderStatusHistory[]
  requestedRefunds     Refund[]             @relation("RefundRequestedBy")
  approvedRefunds      Refund[]             @relation("RefundApprovedBy")
  couponRedemptions    CouponRedemption[]
  wishlist             Wishlist?
  reviews              Review[]             @relation("ReviewAuthor")
  moderatedReviews     Review[]             @relation("ReviewModerator")
  returns              Return[]             @relation("ReturnCustomer")
  reviewedReturns      Return[]             @relation("ReturnReviewer")
  journalArticles      JournalArticle[]
  uploadedMediaAssets  MediaAsset[]
  auditLogs            AuditLog[]

  @@map("users")
}

model Session {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  scope         SessionScope @default(CUSTOMER)
  tokenHash     String       @unique @map("token_hash") @db.Char(64)
  csrfSecret    String       @map("csrf_secret") @db.Char(64)
  mfaVerifiedAt DateTime?    @map("mfa_verified_at") @db.Timestamptz(3)
  ipAddress     String?      @map("ip_address") @db.Inet
  userAgent     String?      @map("user_agent") @db.VarChar(512)
  expiresAt     DateTime     @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?    @map("revoked_at") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, revokedAt])
  @@map("sessions")
}

model VerificationToken {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String                @map("user_id") @db.Uuid
  type       VerificationTokenType
  tokenHash  String                @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime              @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?             @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

model MfaRecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.Text
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique @db.VarChar(100)
  module      String  @db.VarChar(64)
  description String? @db.Text

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedBy String?  @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  user     User  @relation("UserAssignedRoles", fields: [userId], references: [id], onDelete: Cascade)
  role     Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assigner User? @relation("RoleAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Address {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  label         String    @default("Primary") @db.VarChar(64)
  recipientName String    @map("recipient_name") @db.VarChar(160)
  phone         String    @db.VarChar(32)
  addressLine1  String    @map("address_line_1") @db.VarChar(255)
  addressLine2  String?   @map("address_line_2") @db.VarChar(255)
  subdistrict   String?   @db.VarChar(120)
  city          String    @db.VarChar(120)
  province      String    @db.VarChar(120)
  postalCode    String    @map("postal_code") @db.VarChar(16)
  countryCode   String    @default("ID") @map("country_code") @db.Char(2)
  isDefault     Boolean   @default(false) @map("is_default")
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// =============================================================================
// Domain 2: Catalog
// =============================================================================

model Category {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId    String?   @map("parent_id") @db.Uuid
  slug        String    @unique @db.VarChar(140)
  name        String    @db.VarChar(140)
  description String?   @db.Text
  sizeGuide   Json?     @map("size_guide") @db.JsonB
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent            Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children          Category[]        @relation("CategoryHierarchy")
  productCategories ProductCategory[]

  @@index([parentId, sortOrder])
  @@index([isActive, deletedAt])
  @@map("categories")
}

model Product {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String        @unique @db.VarChar(180)
  name              String        @db.VarChar(220)
  description       String        @db.Text
  material          String        @db.Text
  fit               String        @db.VarChar(120)
  careInstruction   String        @map("care_instruction") @db.Text
  status            ProductStatus @default(DRAFT)
  isVisible         Boolean       @default(true) @map("is_visible")
  isFeatured        Boolean       @default(false) @map("is_featured")
  has3dEnabled      Boolean       @default(false) @map("has_3d_enabled")
  seoTitle          String?       @map("seo_title") @db.VarChar(160)
  seoDescription    String?       @map("seo_description") @db.VarChar(320)
  sizeGuideOverride Json?         @map("size_guide_override") @db.JsonB
  publishedAt       DateTime?     @map("published_at") @db.Timestamptz(3)
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  productCategories    ProductCategory[]
  collectionProducts   CollectionProduct[]
  variants             ProductVariant[]
  media                ProductMedia[]
  assets3d             Product3DAsset[]
  customizationPresets CustomizationPreset[]
  showroomHotspots     ShowroomHotspot[]
  wishlistItems        WishlistItem[]
  reviews              Review[]

  @@index([status, isVisible, deletedAt])
  @@map("products")
}

model ProductCategory {
  productId  String  @map("product_id") @db.Uuid
  categoryId String  @map("category_id") @db.Uuid
  isPrimary  Boolean @default(false) @map("is_primary")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, productId])
  @@map("product_categories")
}

model Collection {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String           @unique @db.VarChar(160)
  name         String           @db.VarChar(160)
  description  String?          @db.Text
  status       CollectionStatus @default(DRAFT)
  startsAt     DateTime?        @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime?        @map("ends_at") @db.Timestamptz(3)
  heroMediaUrl String?          @map("hero_media_url") @db.Text
  deletedAt    DateTime?        @map("deleted_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  collectionProducts CollectionProduct[]

  @@index([status, startsAt, endsAt])
  @@map("collections")
}

model CollectionProduct {
  collectionId String @map("collection_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([collectionId, position])
  @@map("collection_products")
}

model ProductVariant {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId         String    @map("product_id") @db.Uuid
  sku               String    @unique @db.VarChar(64)
  size              String    @db.VarChar(32)
  color             String    @db.VarChar(64)
  colorHex          String?   @map("color_hex") @db.Char(7)
  priceIdr          BigInt    @map("price_idr") @db.BigInt
  compareAtPriceIdr BigInt?   @map("compare_at_price_idr") @db.BigInt
  weightGrams       Int       @map("weight_grams")
  lengthCm          Int?      @map("length_cm")
  widthCm           Int?      @map("width_cm")
  heightCm          Int?      @map("height_cm")
  isActive          Boolean   @default(true) @map("is_active")
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  product              Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  media                ProductMedia[]
  assets3d             Product3DAsset[]
  customizationPresets CustomizationPreset[]
  showroomHotspots     ShowroomHotspot[]
  inventoryLevels      InventoryLevel[]
  inventoryMovements   InventoryMovement[]
  stockReservations    StockReservation[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  wishlistItems        WishlistItem[]

  @@index([productId, isActive])
  @@index([productId, color, size])
  @@map("product_variants")
}

model ProductMedia {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String    @map("product_id") @db.Uuid
  variantId String?   @map("variant_id") @db.Uuid
  type      MediaType
  objectKey String    @map("object_key") @db.VarChar(512)
  url       String    @db.Text
  altText   String    @map("alt_text") @db.VarChar(255)
  position  Int       @default(0)
  width     Int?
  height    Int?
  isPrimary Boolean   @default(false) @map("is_primary")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, position])
  @@index([variantId])
  @@map("product_media")
}

// =============================================================================
// Domain 3: 3D Assets, Presets & Outfit Studio
// =============================================================================

model Product3DAsset {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId       String      @map("product_id") @db.Uuid
  variantId       String?     @map("variant_id") @db.Uuid
  version         Int
  format          AssetFormat @default(GLB)
  objectKey       String      @unique @map("object_key") @db.VarChar(512)
  mobileObjectKey String?     @map("mobile_object_key") @db.VarChar(512)
  posterKey       String      @map("poster_key") @db.VarChar(512)
  bytes           BigInt      @db.BigInt
  status          AssetStatus @default(UPLOADED)
  isActiveVersion Boolean     @default(false) @map("is_active_version")
  config          Json        @default("{}") @db.JsonB
  publishedAt     DateTime?   @map("published_at") @db.Timestamptz(3)
  createdBy       String?     @map("created_by") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  product              Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant              ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: SetNull)
  creator              User?                 @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  validationRuns       AssetValidationRun[]
  customizationPresets CustomizationPreset[]

  @@unique([productId, version])
  @@index([productId, status, isActiveVersion])
  @@map("product_3d_assets")
}

model AssetValidationRun {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId          String                @map("asset_id") @db.Uuid
  status           AssetValidationStatus @default(QUEUED)
  validatorVersion String                @map("validator_version") @db.VarChar(32)
  report           Json                  @default("{}") @db.JsonB
  errorSummary     String?               @map("error_summary") @db.Text
  startedAt        DateTime?             @map("started_at") @db.Timestamptz(3)
  completedAt      DateTime?             @map("completed_at") @db.Timestamptz(3)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  asset Product3DAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, createdAt(sort: Desc)])
  @@map("asset_validation_runs")
}

model CustomizationPreset {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  assetId           String   @map("asset_id") @db.Uuid
  code              String   @db.VarChar(64)
  label             String   @db.VarChar(120)
  swatchHex         String   @map("swatch_hex") @db.Char(7)
  materialOverrides Json     @map("material_overrides") @db.JsonB
  variantId         String?  @map("variant_id") @db.Uuid
  isActive          Boolean  @default(true) @map("is_active")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  asset   Product3DAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([assetId, code])
  @@map("customization_presets")
}

model OutfitScene {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String?  @map("user_id") @db.Uuid
  title               String   @db.VarChar(160)
  mannequinRigVersion String   @map("mannequin_rig_version") @db.VarChar(64)
  items               Json     @db.JsonB
  isPublicPreset      Boolean  @default(false) @map("is_public_preset")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt(sort: Desc)])
  @@index([isPublicPreset])
  @@map("outfit_scenes")
}

model ShowroomZone {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String             @unique @db.VarChar(64)
  title              String             @db.VarChar(160)
  description        String?            @db.Text
  status             ShowroomZoneStatus @default(DRAFT)
  sortOrder          Int                @default(0) @map("sort_order")
  sceneObjectKey     String             @unique @map("scene_object_key") @db.VarChar(512)
  liteSceneObjectKey String?            @map("lite_scene_object_key") @db.VarChar(512)
  posterKey          String             @map("poster_key") @db.VarChar(512)
  sceneBytes         BigInt             @map("scene_bytes") @db.BigInt
  liteSceneBytes     BigInt?            @map("lite_scene_bytes") @db.BigInt
  cameraBaseline     Json               @default("{}") @map("camera_baseline") @db.JsonB
  portals            Json               @default("[]") @db.JsonB
  config             Json               @default("{}") @db.JsonB
  publishedAt        DateTime?          @map("published_at") @db.Timestamptz(3)
  createdBy          String?            @map("created_by") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  creator  User?             @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  hotspots ShowroomHotspot[]

  @@index([status, sortOrder])
  @@map("showroom_zones")
}

model ShowroomHotspot {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zoneId    String   @map("zone_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  variantId String?  @map("variant_id") @db.Uuid
  label     String   @db.VarChar(120)
  positionX Float    @map("position_x") @db.DoublePrecision
  positionY Float    @map("position_y") @db.DoublePrecision
  positionZ Float    @map("position_z") @db.DoublePrecision
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  zone    ShowroomZone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

