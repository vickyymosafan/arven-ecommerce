  user            User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  mergedIntoCart  Cart?      @relation("CartMergeTarget", fields: [mergedIntoCartId], references: [id], onDelete: SetNull)
  mergedFromCarts Cart[]     @relation("CartMergeTarget")
