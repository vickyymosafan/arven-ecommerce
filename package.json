{
  "name": "arven-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.15.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @arven/database prisma:generate",
    "db:migrate": "pnpm --filter @arven/database prisma:migrate",
    "db:seed": "pnpm --filter @arven/database prisma:seed",
    "contracts:generate": "pnpm --filter @arven/api openapi:export && pnpm --filter @arven/contracts build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "turbo": "^2.11.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
