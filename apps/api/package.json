{
  "name": "@arven/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:integration": "vitest run test/security/catalog-integration.test.ts",
    "openapi:export": "tsx src/scripts/export-openapi.ts",
    "check:auth-metadata": "tsx src/scripts/check-auth-metadata.ts"
  },
  "dependencies": {
    "@arven/config": "workspace:*",
    "@arven/contracts": "workspace:*",
    "@arven/database": "workspace:*",
    "@arven/observability": "workspace:*",
    "@arven/validators": "workspace:*",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/throttler": "^6.7.1",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.5.0",
    "otplib": "^13.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.5.0",
    "@swc/core": "^1.16.22",
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^22.15.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
